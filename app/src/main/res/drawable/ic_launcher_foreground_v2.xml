    <path
        android:pathData="M14,14 C34,6 74,6 94,14 C94,20 90,24 90,24 C68,12 40,12 18,24 C12,22 14,14 14,14 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="8"
                android:endX="54" android:endY="28"
                android:type="linear">
                <item android:offset="0.0" android:color="#30FFFFFF"/>
                <item android:offset="1.0" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
