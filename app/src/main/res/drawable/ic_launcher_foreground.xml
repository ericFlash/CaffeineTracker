<?xml version="1.0" encoding="utf-8"?>
<!-- V4 冰美式 + 代谢曲线：透明直壁冰杯，杯中深冰咖啡的液面上边缘即代谢曲线
     （左高=刚摄入，右低=随时间代谢殆尽），亮金曲线为视觉焦点，冰块强化"冰"属性。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 托盘（浅奶咖圆盘，位于杯底） -->
    <path
        android:pathData="M34,74 C34,71.2 44,69 54,69 C64,69 74,71.2 74,74 C74,76.8 64,79 54,79 C44,79 34,76.8 34,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="34" android:startY="69"
                android:endX="74" android:endY="79"
                android:type="linear">
                <item android:offset="0.0" android:color="#E9D8C3"/>
                <item android:offset="1.0" android:color="#B8926B"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- 落地阴影 -->
    <path
        android:pathData="M34,78 C43,75.6 65,75.6 74,78 C66,80.2 42,80.2 34,78 Z"
        android:fillColor="#2A160A"
        android:fillAlpha="0.18" />

    <!-- 透明直壁冰杯外廓 -->
    <path
        android:pathData="M36,34 L36,68 Q36,72 40,72 L68,72 Q72,72 72,68 L72,34"
        android:strokeWidth="2.2"
        android:strokeColor="#F5E4CE"
        android:strokeAlpha="0.85"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <!-- 杯口高光 -->
    <path
        android:pathData="M38,34 L70,34"
        android:strokeWidth="2.4"
        android:strokeColor="#EFD9C0"
        android:strokeAlpha="0.9"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <!-- 右侧霜冷高光 -->
    <path
        android:pathData="M69,42 L69,58"
        android:strokeWidth="1.6"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- 深冰咖啡液面（代谢曲线以下实心） -->
    <path
        android:pathData="M38,70 L38,46 C43,44 47,48 52,51 C58,55 63,57 70,58 L70,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38" android:startY="46"
                android:endX="70" android:endY="70"
                android:type="linear">
                <item android:offset="0.0" android:color="#6E4729"/>
                <item android:offset="0.5" android:color="#4A2A16"/>
                <item android:offset="1.0" android:color="#2C160A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 代谢曲线（亮金，液面下缘右下行）= 视觉焦点 -->
    <path
        android:pathData="M38,46 C43,44 47,48 52,51 C58,55 63,57 70,58"
        android:strokeWidth="2.6"
        android:strokeColor="#E8B84B"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
    <!-- 起点与终点（当前体内水平）圆点 -->
    <path
        android:pathData="M38,46 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0"
        android:fillColor="#F7DFB9" />
    <path
        android:pathData="M70,58 a1.9,1.9 0 1,0 3.8,0 a1.9,1.9 0 1,0 -3.8,0"
        android:fillColor="#F7DFB9" />

    <!-- 冰块（半透明白，浮于液面上部，突显"冰"） -->
    <path
        android:pathData="M45,40 L55,40 L55,50 L45,50 Z"
        android:strokeWidth="1.2"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.75"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35" />
    <path
        android:pathData="M45,50 L55,50 L52,54 L42,54 Z"
        android:fillColor="#DFD3C2"
        android:fillAlpha="0.5" />
    <path
        android:pathData="M45,40 L42,54 L42,44 L45,40 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.9" />
    <!-- 第二块小冰 -->
    <path
        android:pathData="M60,43 L67,43 L67,50 L60,50 Z"
        android:strokeWidth="1.1"
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.7"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.28" />
    <path
        android:pathData="M60,50 L67,50 L65,54 L58,54 Z"
        android:fillColor="#DFD3C2"
        android:fillAlpha="0.45" />

    <!-- 顶部柔和光泽弧（沿用玻璃/釉面高光） -->
    <path
        android:pathData="M22,18 C37,10 71,10 86,18 C86,22 82,24 82,24 C64,15 44,15 26,24 C22,22 22,18 22,18 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="54" android:startY="10"
                android:endX="54" android:endY="26"
                android:type="linear">
                <item android:offset="0.0" android:color="#30FFFFFF"/>
                <item android:offset="1.0" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

</vector>
