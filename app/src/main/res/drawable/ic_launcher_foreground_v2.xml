<?xml version="1.0" encoding="utf-8"?>
<!-- V2 杯+闪电：咖啡杯侧沿含闪电/能量符号，强调"咖啡因能量/代谢" -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 托盘（浅奶咖圆盘） -->
    <path
        android:pathData="M31,80 C31,75 41.4,71 54,71 C66.6,71 77,75 77,80 C77,85 66.6,89 54,89 C41.4,89 31,85 31,80 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="31" android:startY="71"
                android:endX="77" android:endY="89"
                android:type="linear">
                <item android:offset="0.0" android:color="#E9D8C3"/>
                <item android:offset="1.0" android:color="#B8926B"/>
            </gradient>
        </aapt:attr>
    </path>
    <!-- 托盘内凹阴影 -->
    <path
        android:pathData="M36,77 C36,74.5 43.3,72 54,72 C64.7,72 72,74.5 72,77 C72,79.5 64.7,82 54,82 C43.3,82 36,79.5 36,77 Z"
        android:fillColor="#4A2812"
        android:fillAlpha="0.22" />

    <!-- 咖啡杯主体 -->
    <path
        android:pathData="M40,52 L68,52 L68,72 C68,78.5 61.7,79 54,79 C46.3,79 40,78.5 40,72 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40" android:startY="65"
                android:endX="68" android:endY="65"
                android:type="linear">
                <item android:offset="0.0" android:color="#7A5233"/>
