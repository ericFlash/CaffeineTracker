<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <!-- Top: current level + today total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_caffeine_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@android:color/black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" mg"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginStart="2dp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/widget_today_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="今日 0/400"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="end" />
    </LinearLayout>

    <!-- Bottom: 6 hour forecast (weather-style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center|bottom"
        android:weightSum="6"
        android:layout_marginTop="4dp">

        <!-- Hour 0 -->
        <LinearLayout android:id="@+id/hour_0" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hour_0_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="11sp" android:textColor="#999999"
                android:gravity="center" />
            <TextView android:id="@+id/hour_0_dot" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" android:gravity="center"
                android:background="@drawable/dot_green"
                android:text="" />
            <TextView android:id="@+id/hour_0_level" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center" />
        </LinearLayout>

        <!-- Hour 1 -->
        <LinearLayout android:id="@+id/hour_1" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hour_1_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="11sp" android:textColor="#999999"
                android:gravity="center" />
            <TextView android:id="@+id/hour_1_dot" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" android:gravity="center"
                android:background="@drawable/dot_green"
                android:text="" />
            <TextView android:id="@+id/hour_1_level" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center" />
        </LinearLayout>

        <!-- Hour 2 -->
        <LinearLayout android:id="@+id/hour_2" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hour_2_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="11sp" android:textColor="#999999"
                android:gravity="center" />
            <TextView android:id="@+id/hour_2_dot" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" android:gravity="center"
                android:background="@drawable/dot_green"
                android:text="" />
            <TextView android:id="@+id/hour_2_level" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center" />
        </LinearLayout>

        <!-- Hour 3 -->
        <LinearLayout android:id="@+id/hour_3" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hour_3_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="11sp" android:textColor="#999999"
                android:gravity="center" />
            <TextView android:id="@+id/hour_3_dot" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" android:gravity="center"
                android:background="@drawable/dot_green"
                android:text="" />
            <TextView android:id="@+id/hour_3_level" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center" />
        </LinearLayout>

        <!-- Hour 4 -->
        <LinearLayout android:id="@+id/hour_4" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hour_4_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="11sp" android:textColor="#999999"
                android:gravity="center" />
            <TextView android:id="@+id/hour_4_dot" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" android:gravity="center"
                android:background="@drawable/dot_green"
                android:text="" />
            <TextView android:id="@+id/hour_4_level" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center" />
        </LinearLayout>

        <!-- Hour 5 -->
        <LinearLayout android:id="@+id/hour_5" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:gravity="center">
            <TextView android:id="@+id/hour_5_time" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="11sp" android:textColor="#999999"
                android:gravity="center" />
            <TextView android:id="@+id/hour_5_dot" android:layout_width="16dp"
                android:layout_height="16dp" android:layout_marginTop="4dp"
                android:layout_marginBottom="2dp" android:gravity="center"
                android:background="@drawable/dot_green"
                android:text="" />
            <TextView android:id="@+id/hour_5_level" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="--"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@android:color/black"
                android:gravity="center" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
