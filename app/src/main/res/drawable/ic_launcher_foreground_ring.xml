<?xml version="1.0" encoding="utf-8"?>
<!-- 概念三「能量环豆」自适应图标前景：
     环形进度仪表（体内咖啡因占比语义）+ 中心咖啡豆 + 四向状态色 LED -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 环形仪表底圈（奶油白，低透明度轨道） -->
    <path
        android:pathData="M54,24 A30,30 0 1 1 54,84 A30,30 0 1 1 54,24 Z"
        android:strokeColor="#38FFF1E4"
        android:strokeWidth="5"
        android:fillColor="@android:color/transparent" />

    <!-- 进度弧（能量金，约 2/3，从顶部顺时针） -->
    <path
        android:pathData="M54,24 A30,30 0 1 1 28,69"
        android:strokeColor="#E8B84B"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- 四向状态 LED：绿 / 黄 / 橙 / 红（复用 App 状态色） -->
    <path
        android:pathData="M54,20 A4,4 0 1 1 54,28 A4,4 0 1 1 54,20 Z"
        android:fillColor="#8CAF8A" />
    <path
        android:pathData="M84,50 A4,4 0 1 1 84,58 A4,4 0 1 1 84,50 Z"
        android:fillColor="#C7A34A" />
    <path
        android:pathData="M54,80 A4,4 0 1 1 54,88 A4,4 0 1 1 54,80 Z"
        android:fillColor="#D98E4A" />
    <path
        android:pathData="M24,50 A4,4 0 1 1 24,58 A4,4 0 1 1 24,50 Z"
        android:fillColor="#C2563C" />

    <!-- 中心咖啡豆（深褐，带金色凹槽） -->
    <group
        android:rotation="-30"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:pathData="M40,54 C40,43.5 46.3,35 54,35 C61.7,35 68,43.5 68,54 C68,64.5 61.7,73 54,73 C46.3,73 40,64.5 40,54 Z"
            android:fillColor="#3B2412" />
        <path
            android:pathData="M54,36 C47,47 61,47 54,72"
            android:strokeColor="#E8B84B"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent" />
    </group>
</vector>
