                <item android:offset="0.7" android:color="#6E4729"/>
                <item android:offset="1.0" android:color="#432A16"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 杯口上沿高光 -->
    <path
        android:pathData="M38,50 L70,50 L70,53 L38,53 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="38" android:startY="50"
                android:endX="70" android:endY="53"
                android:type="linear">
                <item android:offset="0.0" android:color="#C89A6B"/>
                <item android:offset="0.5" android:color="#EAD8C0"/>
                <item android:offset="1.0" android:color="#A97A50"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 咖啡液面 -->
    <path
        android:pathData="M40,52 C40,48.8 46.3,46 54,46 C61.7,46 68,48.8 68,52 C68,55.2 61.7,58 54,58 C46.3,58 40,55.2 40,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="44" android:startY="49"
                android:endX="64" android:endY="56"
                android:type="linear">
                <item android:offset="0.0" android:color="#3A2010"/>
                <item android:offset="0.6" android:color="#4A2A16"/>
                <item android:offset="1.0" android:color="#2C160A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- 杯把 -->
    <path
        android:pathData="M68,54 C80,54 84,65 77,72 C74,75 68,76 65.5,75"
        android:strokeWidth="5"
        android:strokeColor="#3A2415"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />
    <path
        android:pathData="M67,56 C77,56 80,65 74.5,70 C72,72.5 67,73.5 65.2,73"
        android:strokeWidth="2.6"
        android:strokeColor="#B08A5E"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent" />

    <!-- 闪电（能量符号）：金色，位于杯体上方，白色描边包边提升辨识度 -->
    <path
        android:pathData="M56,22 L47,40 L54,40 L50,56 L61,37 L54,37 L60,22 Z"
        android:fillColor="#F7DFB9" />
    <path
        android:pathData="M55.5,22.6 L47,39.4 L53.6,39.4 L50.4,54.2 L60.2,37.6 L53.8,37.6 L59.4,22.6 Z"
